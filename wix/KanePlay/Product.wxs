<?define ShortName = "KanePlay" ?>
<?define FullName = "KanePlay" ?>

<?define ShortcutName = "$(var.ShortName)" ?>
<?define ShortcutDesc = "Play the games of your PC on this device" ?>
<?define InstallFolder = "KanePlay" ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="$(var.FullName)"
           Language="1033"
           Version="!(bind.fileVersion.KanePlayExe)"
           Manufacturer="KanePlay"
           UpgradeCode="257c3508-7d5f-47ba-bd69-7e47ff313b4f">
    <!-- KanePlay has its own upgrade code, so it installs next to Moonlight instead of
         replacing it. Windows Installer ignores the build number (4th field) of the
         version, so each build must be allowed to replace one of the same version. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                  Schedule="afterInstallInitialize"
                  AllowSameVersionUpgrades="yes" />
    <MediaTemplate CompressionLevel="high" EmbedCab="yes" />

    <Property Id="APPDATAFOLDER" Value="%LOCALAPPDATA%\KanePlay" />

    <!-- KanePlaySetup.exe passes the user's choice. Without a default, running the MSI on its
         own writes an empty integer to the registry, which fails with error 1406. -->
    <Property Id="ADDDESKTOPSHORTCUT" Value="1" />

    <!-- There's no way to delete a registry key on uninstall but not major upgrade, so
        we have to roll our own deletion via custom action -->
    <CustomAction Id="DeleteRegistryKey"
                  Directory="ProgramFiles6432Folder"
                  ExeCommand="reg.exe delete &quot;HKCU\Software\KanePlay&quot; /f"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="DeleteRegistryKey"
              Before="InstallFinalize"
              Condition="Installed AND REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Component Id="KanePlayShortcuts" Directory="INSTALLFOLDER">
      <Shortcut Id="StartMenuShortcut"
                Name="$(var.ShortcutName)"
                Description="$(var.ShortcutDesc)"
                Target="[#KanePlayExe]"
                Directory="ApplicationProgramsFolder"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="CleanupStartMenuShortcut"
                    Directory="ApplicationProgramsFolder"
                    On="uninstall" />
      <!-- A portable package extracted over the installation would switch it
           to settings files it can't write, and pairing would be lost -->
      <RemoveFile Id="RemoveStrayPortableDat"
                  Name="portable.dat"
                  On="install" />
      <util:RemoveFolderEx Id="CleanupAppDataFolder"
                           On="uninstall"
                           Property="APPDATAFOLDER" />
      <RegistryValue Root="HKCU"
                     Key="Software\KanePlay"
                     Name="Installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Component Id="KanePlayDesktopShortcut" Directory="INSTALLFOLDER" Condition="ADDDESKTOPSHORTCUT=1">
      <Shortcut Id="DesktopShortcut"
                Name="$(var.ShortcutName)"
                Description="$(var.ShortcutDesc)"
                Target="[#KanePlayExe]"
                Directory="DesktopFolder"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="CleanupDesktopShortcut"
                    Directory="DesktopFolder"
                    On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\KanePlay"
                     Name="DesktopShortcutInstalled"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- Persist desktop shortcut's installed state to let Bundle.wxs know if
         the desktop shortcut should installed by default when upgrading the
         product -->
    <Component Id="KanePlayDesktopShortcutState" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKCU"
                     Key="Software\KanePlay"
                     Name="DesktopShortcutInstallState"
                     Type="integer"
                     Value="[ADDDESKTOPSHORTCUT]"
                     KeyPath="yes" />
    </Component>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="KanePlay">
        <File Id="KanePlayExe"
              KeyPath="yes"
              Checksum="yes"
              Source="$(var.BuildDir)\app\$(var.Configuration)\KanePlay.exe">
          <fire:FirewallException Id="KanePlayFirewallException"
                                  Scope="any"
                                  IgnoreFailure="yes"
                                  Name="$(var.FullName)" />
        </File>
      </Component>
    </DirectoryRef>

    <ComponentGroup Id="KanePlayDependencies" Directory="INSTALLFOLDER">
      <Files Include="$(var.DeployDir)\**">
        <!-- The executable is authored above. Portable packages and VC runtime
             files may be present in a reused deploy folder but do not belong in the MSI. -->
        <Exclude Files="$(var.DeployDir)\KanePlay.exe" />
        <Exclude Files="$(var.DeployDir)\portable.dat" />
        <Exclude Files="$(var.DeployDir)\portable.dat.inactive" />
        <Exclude Files="$(var.DeployDir)\concrt140.dll" />
        <Exclude Files="$(var.DeployDir)\msvcp140*.dll" />
        <Exclude Files="$(var.DeployDir)\vcruntime140*.dll" />
      </Files>
    </ComponentGroup>

    <Feature Id="ProductFeature" Title="KanePlay" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="KanePlay" />
      <ComponentRef Id="KanePlayShortcuts" />
      <ComponentRef Id="KanePlayDesktopShortcutState" />
      <ComponentRef Id="KanePlayDesktopShortcut" />
      <ComponentGroupRef Id="KanePlayDependencies" />
    </Feature>

    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.InstallFolder)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="$(var.InstallFolder)" />
    </StandardDirectory>
  </Package>
</Wix>
